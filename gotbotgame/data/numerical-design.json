{
  "schema_version": "qingfengdu.numerical-design.1",
  "task_id": "P2-T4+P2-T5",
  "scope": "全量数值设计：好感度/洞察/碎片/状态标志/结局判定，严格基于《目前8.8.docx》已写文案。",
  "note": "已写文案原样保护，本文档仅定义数值规则和判定条件，不修改任何叙事文本。",
  "variables": {
    "affection": {
      "description": "三角色独立好感度，范围 -100 到 +100",
      "characters": [
        "liu",
        "li",
        "gui"
      ],
      "range": [
        -100,
        100
      ],
      "initial": 0,
      "thresholds": {
        "private_invite": {
          "min": 30,
          "description": "触发角色私下邀约（每晚结算时判定，单角色不重复）"
        },
        "cp_ending": {
          "min": 70,
          "description": "进入CP线（恋人关系）结局"
        },
        "cb_ending": {
          "min": 30,
          "max": 69,
          "description": "进入CB线（挚友/知己关系）结局"
        },
        "hostile": {
          "max": -30,
          "description": "该角色不再主动互动，好感极低时触发疏远文案"
        },
        "neutral": {
          "min": -29,
          "max": 29,
          "description": "普通关系，不影响互动"
        },
        "trusted": {
          "min": 30,
          "max": 49,
          "description": "愿意分享信息"
        },
        "close": {
          "min": 50,
          "max": 69,
          "description": "深层信任，共享关键线索"
        }
      }
    },
    "insight": {
      "description": "全局洞察值，累积不可降，解锁隐藏剧情与特殊对话",
      "range": [
        0,
        99
      ],
      "initial": 0,
      "thresholds": {
        "hidden_line": {
          "min": 4,
          "description": "第三次闲逛安全存活后触发隐藏线【得闲饮茶】入口"
        },
        "truth_dialogue": {
          "min": 2,
          "description": "解锁古玉追问选项（如 liu_ask_truth）"
        },
        "high_perception": {
          "min": 6,
          "description": "在结局对峙中解锁D选项'指出古玉才是关键'"
        }
      }
    },
    "fragments": {
      "description": "剧情碎片累积数，影响真相达成度",
      "range": [
        0,
        99
      ],
      "initial": 0,
      "thresholds": {
        "truth_ending": {
          "min": 8,
          "description": "解锁真相达成结局"
        },
        "partial_truth": {
          "min": 4,
          "max": 7,
          "description": "一知半解结局"
        },
        "missed_truth": {
          "max": 3,
          "description": "错过真相结局"
        }
      }
    },
    "action_count": {
      "description": "三天九时段行动计数",
      "range": [
        0,
        9
      ],
      "initial": 0,
      "max_per_day": 3
    }
  },
  "flags": {
